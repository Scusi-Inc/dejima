{
  "permissions": {
    "allow": [
      "Bash(dejima version *)",
      "Bash(timeout 60 git fsck --no-progress)",
      "Bash(git fetch *)",
      "Bash(git rev-list *)",
      "Bash(timeout 30 dejima doctor)",
      "Bash(timeout 20 dejima overview)",
      "Bash(timeout 20 dejima ls)",
      "Bash(timeout 20 dejima agent ls)",
      "Bash(timeout 60 curl -s \"https://api.github.com/repos/creack/pty/contents/?ref=v1.1.24\")",
      "Bash(timeout 60 curl -s \"https://raw.githubusercontent.com/creack/pty/v1.1.24/start_windows.go\")",
      "Bash(timeout 60 curl -s \"https://raw.githubusercontent.com/creack/pty/v1.1.24/doc.go\")",
      "Bash(python3 -)",
      "Bash(dpkg --print-architecture)",
      "Read(//usr/local/go/bin/**)",
      "Bash(tmux -L cfgv -f /workspace/image/tmux.conf new-session -d -s t)",
      "Bash(echo \"start_exit=$?\")",
      "Bash(tmux -L cfgv show -g terminal-features)",
      "Bash(tmux -L cfgv show -g terminal-overrides)",
      "Bash(tmux -L cfgv kill-server)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
