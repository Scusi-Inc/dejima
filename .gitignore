# Build artifacts
/bin/
/dist/
/dejima
/dejimad

# Multi-agent worktrees (runtime state created under an island's /workspace)
/.agents/
*.exe
*.test
*.out

# Go workspace
go.work
go.work.sum

# Editor / IDE
.vscode/
.idea/
*.swp
.DS_Store

# Local config
.env
.env.local

# Python virtualenvs (SDK dev)
.venv/

# Strategy / GTM notes — intentionally NOT published (repo is public).
# Durable home is a separate private repo; this is an accidental-`git add` guard.
/strategy/

# Claude Code writes settings atomically via a temp sibling; a concurrent
# `git add -A` catches it mid-write and commits a file that never existed.
.claude/settings.local.json.tmp.*

# Core dumps. A crashing toolchain writes these into the working tree, and they
# contain PROCESS MEMORY — including GH_TOKEN and any other secret in the
# environment. One was swept into a commit by `git add -A` and only stopped by
# GitHub push protection.
core
core.*
